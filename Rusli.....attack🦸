import requests
import threading
import time
import random
import sys
import os

def clear_screen():
    os.system('cls' if os.name == 'nt' else 'clear')

def loading_animation(text, duration=3):
    """Menampilkan animasi loading dengan efek mengetik."""
    print(f"\n{text}", end="")
    bars = ["⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏"]
    start_time = time.time()
    while time.time() - start_time < duration:
        for bar in bars:
            sys.stdout.write(f"\r{text} {bar}")
            sys.stdout.flush()
            time.sleep(0.1)
    sys.stdout.write(f"\r{text} ✅ SELESAI!\n")

